#!/bin/bash
# Set the OS 9 theme up on THIS machine.
#
#   os99-install            detect, fix what is safe to fix, report the rest
#   os99-install --check    report only, change nothing
#   os99-install --status   the same questions, answered as JSON, changing
#                           nothing and touching no art -- what the bar widget
#                           reads to know whether setup is still outstanding
#   os99-install --auto     finish the job: everything --check would fix, plus
#                           building and loading the compositor plugin and
#                           applying the theme. This is what the widget's
#                           "Set up OS 99" runs, so that installing the plugin
#                           is the whole install and nothing is left in a README
#   os99-install --remove   undo all of that. It switches to another theme
#                           first, keeps your os99-theme.toml, and leaves the
#                           two hyprpm commands to you -- unloading a plugin
#                           from a running compositor is not a thing to do in
#                           the middle of a script
#   os99-install --selftest a gate against drift: does every script still
#                           parse, does the manifest still agree with itself,
#                           does os99-run still hold a deadline and cap its
#                           output. Touches nothing outside a temp directory
#   os99-install --version  the version, for anything that wants to check it
#
# The theme is not one artefact. It is art baked at this display's scale, a
# forked hyprbars plugin, two theme-set hooks, a config file and a shell plugin,
# and only some of those can be carried in a git repo. This script does the part
# that has to happen per machine, and tells you plainly what it cannot do.
#
# It is safe to re-run. Run it again after changing monitors -- that is the whole
# point of it, because the art is authored at DEVICE resolution and blitted 1:1,
# so a display at a different scale does not merely look a bit off, it renders
# the entire window frame at the wrong size.
set -uo pipefail

# Everything shared lives in one file beside this one: which Hyprland is
# actually listening, where state goes, how a config file is published.
_os99_lib="$(dirname -- "$(readlink -f "$0")")/os99-lib.sh"
# shellcheck source=os99-lib.sh
source "$_os99_lib" || { echo "os99-install: missing $_os99_lib" >&2; exit 1; }

# Bumped by hand, and checked against manifest.json by --selftest: a version
# that only one of them knows is a version nobody can trust.
OS99_VERSION="1.2.0"

CHECK=false
AUTO=false
STATUS=false
REMOVE=false
SELFTEST=false
# Unknown arguments must not fall through to a real install. They used to: any
# flag that was not --check simply left CHECK=false, so `os99-install --help`
# quietly performed a full install -- copying plugins, rewriting hooks, and
# registering bar widgets on a machine where somebody was only asking a question.
case "${1:-}" in
  "")        ;;
  --check)   CHECK=true ;;
  --status)  STATUS=true ;;
  --auto)    AUTO=true ;;
  --remove)  REMOVE=true ;;
  --selftest) SELFTEST=true ;;
  --version) echo "$OS99_VERSION"; exit 0 ;;
  # Print the header block, however long it grows, rather than a line range
  # that silently starts spilling code the moment somebody adds a paragraph.
  -h|--help) sed -n '2,/^[^#]/p' "$0" | sed '$d; s/^# \?//'; exit 0 ;;
  *)
    echo "os99-install: unknown option '$1'" >&2
    echo "usage: os99-install [--check | --status | --auto | --remove | --selftest]" >&2
    exit 2
    ;;
esac

PLUGIN_ID="io.github.caariiboouu.os-99"
SHELLJSON="$HOME/.config/omarchy/shell.json"
TOML="$HOME/.config/omarchy/os99-theme.toml"
GEN="$HOME/.config/omarchy/themes/os-99-platinum/decor/generate-art.py"
HOOKS="$HOME/.config/omarchy/hooks/theme-set.d"
LOOKNFEEL="$HOME/.config/hypr/looknfeel.lua"

ok=0; warn=0; fail=0
say()  { printf '  %s\n' "$*"; }
good() { printf '  \033[32mok\033[0m    %s\n' "$*"; ok=$((ok+1)); }
note() { printf '  \033[33mnote\033[0m  %s\n' "$*"; warn=$((warn+1)); }
bad()  { printf '  \033[31mmiss\033[0m  %s\n' "$*"; fail=$((fail+1)); }
head_() { printf '\n\033[1m%s\033[0m\n' "$*"; }

# A compositor that answers, or none at all. --status and --check are useful
# without one; everything else says what it cannot reach rather than talking to
# a socket nobody is listening on.
os99_use_hyprland || true

# shell.json is the user's file and it is not reconstructible from anything
# else -- a previous session emptied it and took seven widgets with it. So every
# read and every write goes through one program, and that program never writes
# anything: it prints the file it wants, and os99_publish puts it there
# atomically. The split is the point. The part that knows about bar layouts
# cannot get the durability wrong, and the part that knows about durability is
# the same one every other OS 99 script uses.
#
#   shelljson has-old            -> 0 if a merged-away j.os99-* widget is listed
#   shelljson has <id>           -> 0 if <id> is in the bar layout
#   shelljson_write drop-old     remove the merged-away widgets
#   shelljson_write add <id>     put <id> at the front of the right section
#   shelljson_write remove <id>  take it out of every section
shelljson() {
  python3 - "$SHELLJSON" "$@" <<'PYEOF'
import json, os, sys

OLD = {"j.os99-font", "j.os99-minimized"}

# Follow a symlink once, then read what it names: people keep shell.json in a
# dotfiles repository, and the publisher renames onto the resolved path too.
path = os.path.realpath(sys.argv[1])
cmd = sys.argv[2]

fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
with os.fdopen(fd, "r", encoding="utf-8") as fh:
    d = json.load(fh)
lay = d.get("bar", {}).get("layout", {})
listed = [w.get("id") for sec in lay.values() for w in sec]


def emit():
    # Match the file's own formatting exactly -- one-space indent, sorted keys,
    # and NO trailing newline -- so this shows up as a one-line diff rather than
    # a rewrite of the whole file.
    json.dump(d, sys.stdout, indent=1, sort_keys=True)


if cmd == "has-old":
    sys.exit(0 if any(w in OLD for w in listed) else 1)

if cmd == "has":
    sys.exit(0 if sys.argv[3] in listed else 1)

if cmd == "drop-old":
    for sec in lay:
        lay[sec] = [w for w in lay[sec] if w.get("id") not in OLD]
    emit()
    sys.exit(0)

if cmd == "remove":
    for sec in lay:
        lay[sec] = [w for w in lay[sec] if w.get("id") != sys.argv[3]]
    emit()
    sys.exit(0)

if cmd == "add":
    sec = d.setdefault("bar", {}).setdefault("layout", {}).setdefault("right", [])
    # Front of the right section. The widget is only visible when something IS
    # minimized, so the position is mostly cosmetic.
    sec.insert(0, {"id": sys.argv[3]})
    emit()
    sys.exit(0)

sys.exit(2)
PYEOF
}

shelljson_write() {
  local out
  out=$(shelljson "$@") || return 1
  printf '%s' "$out" | os99_publish "$SHELLJSON"
}

# ALWAYS back up before a write. The layout is not reconstructible.
backup_shelljson() { cp -p "$SHELLJSON" "$SHELLJSON.bak.$(date +%s)"; }

# Where this came from, for hyprpm. The plugin directory left by
# `omarchy plugin add` is a git checkout, so it knows its own origin; the
# constant is only the fallback for a copy that has lost it.
repo_url() {
  local here url
  here=$(cd -- "$(dirname -- "$(readlink -f "$0")")/.." && pwd) || here=""
  if [[ -n $here && -d $here/.git ]]; then
    url=$(git -C "$here" remote get-url origin 2>/dev/null) || url=""
    [[ -n $url ]] && { printf '%s\n' "$url"; return 0; }
  fi
  printf '%s\n' "https://github.com/caariiboouu/os-99"
}

# ------------------------------------------------------------------ 0. status
# Every question the report below asks, answered as JSON and answered CHEAPLY:
# no art is drawn, nothing is copied, nothing is written. The bar widget calls
# this on every start to decide whether to offer setup, so it has to be the kind
# of thing that can run on every start.
#
# `fixable` is the honest half. A step this script can finish gets offered as a
# button; one it cannot -- a missing python3 -- gets shown with the command that
# does fix it, because the point of all this is that nobody has to go and find a
# README to learn what is left.
if $STATUS; then
  THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "")
  st_deps=false;   command -v python3 >/dev/null 2>&1 && command -v hyprctl >/dev/null 2>&1 &&
                   python3 -c 'import tomllib' 2>/dev/null && st_deps=true
  st_files=false;  [[ -f $TOML && -f $GEN && -f $HOOKS/os99-bars-hook.sh ]] && st_files=true
  st_art=false;    [[ -f $HOME/.config/omarchy/themes/os-99-platinum/decor/bar.env ]] && st_art=true
  st_widget=false
  [[ -f $SHELLJSON ]] && shelljson has "$PLUGIN_ID" 2>/dev/null && st_widget=true
  st_plugin=false; hyprctl plugin list 2>/dev/null | grep -q hyprbars && st_plugin=true

  # A plugin that is not loaded has two very different stories behind it, and
  # they want different words. Never built: this is a fresh install. Built, and
  # for a DIFFERENT Hyprland: the frames were working this morning and an
  # upgrade took them, which is the failure people actually hit and the one that
  # otherwise looks like the theme breaking for no reason.
  BUILTF="$HOME/.local/lib/libhyprbars-os99.built"
  PLUGIN_REASON=""
  BUILT_TAG=""
  RUN_TAG=$(hyprctl version 2>/dev/null | sed -n 's/^Tag: \([^,]*\).*/\1/p' | head -1)
  if ! $st_plugin; then
    BUILT_TAG=$(sed -n 's/^HYPRLAND_TAG=//p' "$BUILTF" 2>/dev/null | head -1)
    # .built is the precise answer and .path is the fallback: an install made
    # before .built existed still has a build pointer, and "you had this
    # working and an upgrade took it" is the right story for it either way.
    if [[ -f $BUILTF || -r $HOME/.local/lib/libhyprbars-os99.path ]]
    then PLUGIN_REASON=stale; else PLUGIN_REASON=missing; fi
  fi
  st_theme=false;  [[ $THEME_NAME == os-99-* ]] && st_theme=true
  st_hyprpm=false; command -v hyprpm >/dev/null 2>&1 && st_hyprpm=true

  # A run that started and never finished. Reported only when something is
  # actually outstanding: if every step passes, whatever was interrupted
  # evidently got far enough, and saying so would be noise.
  SESSION=$(os99_session_interrupted || true)
  SESSION_OP=$(sed -n 's/^OP=//p' <<<"$SESSION" | head -1)
  SESSION_THEME=$(sed -n 's/^THEME_BEFORE=//p' <<<"$SESSION" | head -1)

  DEPS=$st_deps FILES=$st_files ART=$st_art WIDGET=$st_widget PLUGIN=$st_plugin \
  THEME=$st_theme HYPRPM=$st_hyprpm URL="$(repo_url)" \
  REASON="$PLUGIN_REASON" BUILT_TAG="$BUILT_TAG" RUN_TAG="$RUN_TAG" \
  SESSION_OP="$SESSION_OP" SESSION_THEME="$SESSION_THEME" python3 -c '
import json, os

def flag(name):
    return os.environ[name] == "true"

reason = os.environ.get("REASON", "")
built_tag = os.environ.get("BUILT_TAG", "")
run_tag = os.environ.get("RUN_TAG", "")

plugin_label = "window frames (hyprbars)"
if reason == "stale":
    plugin_label = ("window frames — built for Hyprland %s, running %s"
                    % (built_tag, run_tag)) if built_tag and run_tag and built_tag != run_tag \
                   else "window frames — the built plugin is not loading"

steps = [
    ("deps",   "python3 and hyprctl",       flag("DEPS"),   flag("DEPS"),
     "install python3 (3.11+) and Hyprland"),
    ("files",  "theme files and hooks",     flag("FILES"),  True,  ""),
    ("art",    "window art for this display", flag("ART"),  True,  ""),
    ("widget", "widget on the status bar",  flag("WIDGET"), True,  ""),
    ("plugin", plugin_label,                flag("PLUGIN"), flag("HYPRPM"),
     "install hyprpm (it ships with Hyprland)"),
    ("theme",  "OS 99 theme applied",       flag("THEME"),  True,  ""),
]
rows = [{"id": i, "label": l, "done": d, "fixable": f, "hint": h}
        for (i, l, d, f, h) in steps]
ready = all(r["done"] for r in rows)
outstanding = [r["id"] for r in rows if not r["done"]]

# The words the bar should use. A rebuild after a system upgrade is not a
# "setup", and calling it one would tell somebody who has been running this for
# months that their install never finished.
session_op = os.environ.get("SESSION_OP", "")
session_theme = os.environ.get("SESSION_THEME", "")

upgraded = bool(built_tag and run_tag and built_tag != run_tag)
if ready:
    headline, action = "", ""
elif session_op == "remove":
    # Nothing here should offer to finish a removal. Re-running it is one
    # command, and a button that uninstalls is not a button to put in a bar.
    headline, action = "An OS 99 removal did not finish", ""
elif session_op == "auto":
    headline, action = "Setup did not finish", "Finish setting up OS 99"
elif outstanding == ["plugin"] and reason == "stale":
    headline = "Hyprland was updated" if upgraded else "The window frames are not loading"
    action = "Rebuild window frames"
else:
    headline, action = "Finish setting up OS 99", "Set up OS 99"

print(json.dumps({
    "ready": ready,
    "canFix": all(r["done"] or r["fixable"] for r in rows),
    "url": os.environ["URL"],
    "reason": reason,
    "headline": headline,
    "action": action,
    "interrupted": ({"op": session_op, "themeBefore": session_theme}
                    if session_op and not ready else None),
    "steps": rows,
}))
'
  exit 0
fi

# --------------------------------------------------------------- 0a. selftest
# The checks that were being done by hand, done by a command.
#
# This is not a test suite for the theme -- it cannot tell you the pinstripe is
# a pixel out. It is a gate against DRIFT: the things that quietly stop being
# true when Omarchy, Quickshell, Hyprland or python move underneath us, and
# which otherwise get discovered by somebody's bar going missing.
#
# It touches nothing outside a temporary directory.
if $SELFTEST; then
  REPO_ROOT=$(cd -- "$(dirname -- "$(readlink -f "$0")")/.." && pwd)
  TMP=$(mktemp -d) || { echo "selftest: no temporary directory" >&2; exit 1; }
  trap 'rm -rf -- "$TMP"' EXIT
  passed=0; failed=0
  t() {  # t <name> <command...>
    local name=$1; shift
    if "$@" >"$TMP/out" 2>&1; then
      printf '  \033[32mpass\033[0m  %s\n' "$name"; passed=$((passed+1))
    else
      printf '  \033[31mFAIL\033[0m  %s\n' "$name"; failed=$((failed+1))
      sed 's/^/          /' "$TMP/out" | head -6
    fi
  }

  head_ "Shape"
  t "required files are present" bash -c '
    cd "$1" || exit 1
    for f in manifest.json hyprpm.toml LICENSE README.md os99-theme.toml \
             bin/os99-lib.sh bin/os99-install bin/os99-run bin/os99-minimize \
             bin/os99-buttons bin/os99-window-bars \
             shell-plugin/os99/Os99BarWidget.qml shell-plugin/os99/Menu.qml \
             plugin/hyprbars/Makefile themes/os-99-platinum/decor/generate-art.py; do
      [[ -e $f ]] || { echo "missing: $f"; exit 1; }
    done' _ "$REPO_ROOT"
  t "no symlinks anywhere in the package" bash -c '
    link=$(find "$1" -name .git -prune -o -type l -print -quit)
    [[ -z $link ]] || { echo "symlink: $link"; exit 1; }' _ "$REPO_ROOT"

  head_ "Syntax"
  # By shebang, not by directory: bin/ holds a python program too, and running
  # bash -n over it reports a syntax error in perfectly good python.
  t "every shell script parses" bash -c '
    fail=0
    while IFS= read -r -d "" f; do
      head -1 "$f" | grep -q "^#!.*\(bash\|sh\)$" || continue
      bash -n "$f" || fail=1
    done < <(find "$1/bin" "$1/hooks" -type f -print0)
    exit $fail' _ "$REPO_ROOT"
  t "every sourced library parses" bash -n "$REPO_ROOT/bin/os99-lib.sh"
  t "every python program parses" bash -c '
    python3 -c "import ast,sys; [ast.parse(open(p).read()) for p in sys.argv[1:]]" \
      "$1/bin/os99-run" "$1/themes/os-99-platinum/decor/generate-art.py"' _ "$REPO_ROOT"
  # A QML syntax error does not raise anything anyone sees: the widget simply
  # never appears. qmllint is the only thing that catches it before a user does.
  if command -v qmllint >/dev/null 2>&1; then
    t "every QML file parses" qmllint "$REPO_ROOT/shell-plugin/os99/Os99BarWidget.qml" \
                                      "$REPO_ROOT/shell-plugin/os99/Menu.qml"
  else
    note "qmllint not installed -- QML is unchecked"
  fi

  head_ "Manifest"
  t "manifest.json parses and matches --version" bash -c '
    python3 - "$1" "$2" <<PYEOF
import json, sys
m = json.load(open(sys.argv[1] + "/manifest.json"))
if m["version"] != sys.argv[2]:
    raise SystemExit("manifest %s != --version %s" % (m["version"], sys.argv[2]))
for key, path in m["entryPoints"].items():
    import os
    if not os.path.exists(os.path.join(sys.argv[1], path)):
        raise SystemExit("entry point missing: %s -> %s" % (key, path))
PYEOF' _ "$REPO_ROOT" "$OS99_VERSION"
  t "hyprpm.toml parses and its pin names a commit we have" bash -c '
    cd "$1" || exit 1
    python3 - <<PYEOF
import subprocess, tomllib
d = tomllib.load(open("hyprpm.toml", "rb"))
for hypr, mine in d["repository"].get("commit_pins", []):
    out = subprocess.run(["git", "cat-file", "-t", mine], capture_output=True, text=True)
    if out.stdout.strip() != "commit":
        raise SystemExit("pinned commit not in this repository: %s" % mine)
PYEOF' _ "$REPO_ROOT"
  if command -v omarchy-plugin-validate >/dev/null 2>&1; then
    t "omarchy accepts the plugin folder" omarchy-plugin-validate "$REPO_ROOT"
  else
    note "omarchy-plugin-validate not installed -- manifest unchecked against the shell"
  fi

  head_ "Behaviour"
  t "--status is valid JSON with the keys the widget reads" bash -c '
    "$1/bin/os99-install" --status | python3 -c "
import json, sys
d = json.load(sys.stdin)
for k in (\"ready\", \"canFix\", \"steps\", \"headline\", \"action\", \"reason\", \"interrupted\"):
    if k not in d:
        raise SystemExit(\"missing key: \" + k)
if not isinstance(d[\"steps\"], list) or not d[\"steps\"]:
    raise SystemExit(\"no steps\")
"' _ "$REPO_ROOT"
  t "os99-run refuses a program that is not one of ours" bash -c '
    "$1/bin/os99-run" -- /bin/echo hi >/dev/null 2>&1 && { echo "it ran /bin/echo"; exit 1; }
    exit 0' _ "$REPO_ROOT"
  t "os99-run holds a deadline and kills the whole group" bash -c '
    d=$2/hang; printf "#!/bin/bash\nsleep 60 &\nsleep 60\n" > "$d"; chmod +x "$d"
    cp "$1/bin/os99-run" "$2/os99-run"
    "$2/os99-run" --deadline 1 -- "$d" >/dev/null 2>&1
    [[ $? -eq 124 ]] || { echo "expected exit 124"; exit 1; }
    sleep 0.3
    pgrep -f "^sleep 60$" >/dev/null && { echo "a child outlived the deadline"; exit 1; }
    exit 0' _ "$REPO_ROOT" "$TMP"
  t "os99-run caps stdout" bash -c '
    cat > "$2/spew" <<"SPEW"
#!/bin/bash
head -c 200000 /dev/zero | tr "\0" "x"
SPEW
    chmod +x "$2/spew"
    cp "$1/bin/os99-run" "$2/os99-run"
    n=$("$2/os99-run" --max-stdout 4096 -- "$2/spew" | wc -c)
    [[ $n -eq 4096 ]] || { echo "got $n bytes, wanted 4096"; exit 1; }' _ "$REPO_ROOT" "$TMP"

  head_ "Writing"
  t "os99_publish replaces atomically and refuses nothing" bash -c '
    source "$1/bin/os99-lib.sh"
    printf "before\n" > "$2/f"
    printf "after\n" | os99_publish "$2/f"
    [[ $(cat "$2/f") == after ]] || { echo "not replaced"; exit 1; }
    printf "" | os99_publish "$2/f" 2>/dev/null && { echo "empty input accepted"; exit 1; }
    [[ $(cat "$2/f") == after ]] || { echo "clobbered by an empty write"; exit 1; }
    exit 0' _ "$REPO_ROOT" "$TMP"
  t "os99-buttons round-trips a config byte for byte" bash -c '
    cp "$1/os99-theme.toml" "$2/cfg.toml"
    cp "$2/cfg.toml" "$2/cfg.before"
    PATH=/usr/bin:/bin OS99_CONFIG=$2/cfg.toml "$1/bin/os99-buttons" toggle pin >/dev/null 2>&1
    PATH=/usr/bin:/bin OS99_CONFIG=$2/cfg.toml "$1/bin/os99-buttons" toggle pin >/dev/null 2>&1
    cmp -s "$2/cfg.before" "$2/cfg.toml" || { echo "config changed across a round trip"; exit 1; }' \
    _ "$REPO_ROOT" "$TMP"

  head_ "Summary"
  printf '  %d passed, %d failed\n' "$passed" "$failed"
  (( failed == 0 )) || exit 1
  exit 0
fi

# ------------------------------------------------------------------ 0b. remove
# Undo the install. One command, because an install that takes one click and an
# uninstall that takes six lines of shell copied out of a README is not a pair.
#
# What it deliberately does NOT do is touch hyprpm. Disabling a plugin unloads
# it from the RUNNING compositor, and that is the one operation here that has
# taken a session down; it is two commands, they are printed at the end, and
# they belong to a moment you choose rather than to the middle of a script.
#
# The theme config is moved aside rather than deleted. Somebody who spent an
# evening tuning ridge counts should not lose it to an uninstall.
if $REMOVE; then
  os99_session_begin remove
  head_ "Wearing something else"
  THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "")
  if [[ $THEME_NAME == os-99-* ]] && command -v omarchy >/dev/null 2>&1; then
    # Anything that is not one of ours. Removing the theme directory out from
    # under the active theme leaves the desktop with no theme at all.
    OTHER=$(omarchy theme list 2>/dev/null | grep -v '^Os 99' | head -1)
    if [[ -n $OTHER ]] && omarchy theme set "$OTHER" >/dev/null 2>&1; then
      good "switched to $OTHER"
    else
      bad "could not switch away from $THEME_NAME -- do that first, then re-run"
      exit 1
    fi
  else
    good "no OS 99 theme is active"
  fi

  head_ "Files"
  if [[ -f $SHELLJSON ]] && shelljson has "$PLUGIN_ID" 2>/dev/null; then
    backup_shelljson
    shelljson_write remove "$PLUGIN_ID" && good "widget off the status bar (backup written)" \
      || bad "could not edit shell.json"
  else
    good "widget was not on the status bar"
  fi

  for h in "$HOME"/.config/omarchy/hooks/theme-set.d/os99-*.sh \
           "$HOME"/.config/omarchy/hooks/post-boot.d/os99-*.sh; do
    [[ -e $h ]] || continue
    rm -f "$h" && say "removed $(basename "$h")"
  done
  good "hooks"

  rm -f "$HOME"/.local/bin/os99-*
  good "scripts out of ~/.local/bin"

  for t in "$HOME"/.config/omarchy/themes/os-99-*; do
    [[ -d $t ]] || continue
    rm -rf "$t" && say "removed $(basename "$t")"
  done
  good "themes"

  if [[ -f $TOML ]]; then
    KEEP="$TOML.removed.$(date +%Y%m%d%H%M%S)"
    mv "$TOML" "$KEEP" && note "kept your tuning at $KEEP"
  fi

  head_ "Plugin"
  if command -v omarchy >/dev/null 2>&1 && [[ -d $HOME/.config/omarchy/plugins/$PLUGIN_ID ]]; then
    rm_log="$(mktemp)"
    if omarchy plugin remove "$PLUGIN_ID" --yes >"$rm_log" 2>&1; then
      good "plugin removed"
    else
      bad "could not remove the plugin:"
      tail -3 "$rm_log" | sed 's/^/      /'
      say "      omarchy plugin remove $PLUGIN_ID"
    fi
    rm -f "$rm_log"
  else
    good "plugin was not installed"
  fi

  os99_session_end
  head_ "Left for you"
  if ! hyprctl plugin list 2>/dev/null | grep -q hyprbars; then
    good "the frame plugin is already unloaded"
  else
    # Which command depends on who loaded it, and guessing wrong sends somebody
    # to a hyprpm that has never heard of this plugin.
    say "The frame plugin is still loaded. Unloading it takes the window frames"
    say "with it, so it is yours to time:"
    say ""
    if hyprpm list 2>/dev/null | grep -q hyprbars-os99; then
      say "      hyprpm disable hyprbars-os99"
      say "      hyprpm remove $(repo_url)"
    else
      say "      hyprctl plugin unload $(cat "$HOME/.local/lib/libhyprbars-os99.path" 2>/dev/null)"
    fi
  fi
  exit 0
fi

# --auto is the one mode that changes several things in a row, so it is the one
# that can be caught halfway. Record that it started; clear it only if it got
# all the way through.
$AUTO && os99_session_begin auto

# --------------------------------------------------------------------- 1. deps
head_ "Prerequisites"
for c in python3 hyprctl fc-list; do
  if command -v "$c" >/dev/null; then good "$c"; else bad "$c not found"; fi
done
# The generator is deliberately stdlib-only -- no PIL, no fonttools -- so that
# installing the theme never means installing a Python toolchain.
if python3 -c 'import tomllib, zlib, struct, fractions' 2>/dev/null; then
  good "python3 stdlib (tomllib, zlib) -- the generator needs nothing else"
else
  bad "python3 >= 3.11 required (tomllib)"
fi
[[ -f $TOML ]] && good "config $TOML" || bad "config missing: $TOML"
[[ -f $GEN  ]] && good "generator present" || bad "generator missing: $GEN"

# ------------------------------------------------------------------ 1b. files
# Copy the pieces into place, when run from a repository checkout. Everything
# below this point works the same whether the files arrived here or were already
# installed, which is why this is a copy step and not a whole install mode.
REPO=""
_self=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
[[ -d $_self/themes && -d $_self/hooks && -d $_self/bin ]] && REPO="$_self"

head_ "Files"
if [[ -z $REPO ]]; then
  say "not running from a checkout -- checking what is already installed"
elif $CHECK; then
  say "(--check) would install from $REPO"
else
  install -d "$HOME/.local/bin"
  for f in "$REPO"/bin/*; do install -m755 "$f" "$HOME/.local/bin/"; done
  good "scripts -> ~/.local/bin"

  # Hooks go through omarchy's own installer when it exists, so they land
  # wherever it decides they belong; otherwise copy them ourselves.
  if command -v omarchy-hook-install >/dev/null 2>&1; then
    for t in theme-set post-boot; do
      for f in "$REPO"/hooks/$t.d/*; do
        [[ -e $f ]] || continue
        omarchy-hook-install "$t" "$f" >/dev/null 2>&1 || install -Dm755 "$f" "$HOME/.config/omarchy/hooks/$t.d/$(basename "$f")"
      done
    done
    good "hooks -> ~/.config/omarchy/hooks/*.d"
  else
    note "no Omarchy -- skipping hooks (nothing to hook into)"
  fi

  if [[ -d $HOME/.config/omarchy/themes || -d $HOME/.config/omarchy ]]; then
    install -d "$HOME/.config/omarchy/themes"
    for t in "$REPO"/themes/*; do cp -r "$t" "$HOME/.config/omarchy/themes/"; done
    good "themes -> ~/.config/omarchy/themes ($(ls -1 "$REPO"/themes | wc -l) of them)"
    install -d "$HOME/.config/omarchy/plugins"
    # The bar widget is one plugin whose manifest sits at the REPO ROOT -- that
    # is the layout `omarchy plugin add` and the plugin marketplace both
    # require. When the repo was cloned by `omarchy plugin add`, it already IS
    # the plugin directory and copying it into itself would be silly; from any
    # other checkout, recreate that layout under ~/.config/omarchy/plugins.
    plugdir="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
    if [[ $REPO == "$plugdir" ]]; then
      good "running from the installed plugin -- widget already in place"
    else
      install -d "$plugdir/shell-plugin" "$plugdir/bin"
      install -m644 "$REPO/manifest.json" "$plugdir/manifest.json"
      # Replace the directory rather than copying over it. A plain copy leaves
      # files that the repository has since deleted, and a stale QML file is
      # not inert: an entry point renamed away is still a local type, and a
      # local type shadows things.
      rm -rf "$plugdir/shell-plugin/os99"
      cp -r "$REPO/shell-plugin/os99" "$plugdir/shell-plugin/"
      # The widget's helpers go WITH it. The QML resolves them relative to its
      # own file rather than looking them up on $PATH, so the copy that answers
      # the bar is always the copy that shipped with the bar -- there is no
      # separate step that has to have happened first, and no chance of a
      # different os99-minimize earlier in someone's PATH being the one that
      # runs. `omarchy plugin add` clones the whole repository and so brings
      # these along by itself; this is the other route saying the same thing.
      # os99-install itself goes too: the widget offers to finish the setup,
      # and it can only do that if the thing that finishes it is beside it.
      for h in os99-lib.sh os99-run os99-minimize os99-buttons os99-menubar-font \
               os99-theme-reload os99-install os99-window-bars os99-hyprbars-rebuild \
               os99-widget-check; do
        install -m755 "$REPO/bin/$h" "$plugdir/bin/$h"
      done
      good "bar widget + helpers -> ~/.config/omarchy/plugins/$PLUGIN_ID"
    fi
    # The two widgets this one replaced. Leaving them would put the same count
    # in the bar twice.
    for old in j.os99-font j.os99-minimized; do
      if [[ -d $HOME/.config/omarchy/plugins/$old ]]; then
        rm -rf "$HOME/.config/omarchy/plugins/$old"
        note "removed old $old (merged into $PLUGIN_ID)"
      fi
    done
    # j.osd is a one-line fork of Omarchy's OSD. It has to be ENABLED, not just
    # copied, because enabling is what switches the shell off omarchy.osd. See
    # shell-plugin/j.osd/WHY.md for what it changes and why theme data cannot.
    if [[ -d $REPO/shell-plugin/j.osd ]]; then
      cp -r "$REPO/shell-plugin/j.osd" "$HOME/.config/omarchy/plugins/"
      if command -v omarchy-plugin-enable >/dev/null 2>&1; then
        omarchy-plugin-enable j.osd >/dev/null 2>&1 && good "j.osd enabled (fixes OSD toast contrast)" \
          || note "could not enable j.osd -- run: omarchy plugin enable j.osd"
      fi
    fi
  else
    note "no Omarchy -- themes not copied; generate art with --out instead (see README)"
  fi

  # NEVER clobber an existing tuning file. Someone re-running this after
  # adjusting ridge counts and palettes should not silently lose that.
  for dest in "$HOME/.config/omarchy/os99-theme.toml" "$HOME/.config/os99/os99-theme.toml"; do
    d=$(dirname "$dest")
    [[ -d $d ]] || continue
    if [[ -f $dest ]]; then good "config already present at ${dest/#$HOME/\~} -- left alone"
    else install -Dm644 "$REPO/os99-theme.toml" "$dest"; good "config -> ${dest/#$HOME/\~}"; fi
    break
  done
fi

# -------------------------------------------------------------------- 2. scale
head_ "Display scale"
DETECTED=$(hyprctl monitors -j 2>/dev/null | python3 -c '
import json,sys
try: mons=json.load(sys.stdin)
except Exception: sys.exit(1)
if not mons: sys.exit(1)
f=next((m for m in mons if m.get("focused")), mons[0])
scales={round(float(m.get("scale",1)),6) for m in mons}
print(round(float(f.get("scale",1)),6), f.get("name","?"), len(scales))
' 2>/dev/null)
if [[ -z $DETECTED ]]; then
  note "could not ask the compositor; leaving the configured scale alone"
else
  read -r DSCALE DNAME DNSCALES <<<"$DETECTED"
  CONFIGURED=$(python3 -c '
import tomllib,sys
c=tomllib.load(open(sys.argv[1],"rb")).get("display",{}).get("scale","auto")
print(c)' "$TOML" 2>/dev/null)
  say "compositor reports $DSCALE on $DNAME; config says $CONFIGURED"
  if (( DNSCALES > 1 )); then
    # One set of art, one scale. There is no per-monitor art in this design.
    note "monitors run at DIFFERENT scales -- the art can only match one of them."
    note "     The frame will be the wrong size on the others. Set them equal, or"
    note "     pick which monitor to be correct on by pinning scale in the toml."
  fi
  if [[ $CONFIGURED == auto ]]; then
    good "scale = \"auto\" -- follows the display, nothing to do"
  elif [[ $CONFIGURED == "$DSCALE" ]]; then
    good "configured scale matches the display"
  else
    bad "configured scale $CONFIGURED does not match the display $DSCALE"
    if ! $CHECK; then
      say "      -> setting scale = \"auto\" so it tracks the display from now on"
      sed -i 's/^scale = .*/scale = "auto"/' "$TOML" && good "toml updated"
    fi
  fi
fi

# -------------------------------------------------------------------- 3. fonts
head_ "Fonts"
FAMS=$(fc-list : family 2>/dev/null | tr ',' '\n' | sed 's/^ *//;s/ *$//' | sort -u)
have() { grep -qxF "$1" <<<"$FAMS"; }
if have Charcoal; then
  good "Charcoal -- the real OS 9 system font"
elif have ChicagoFLF; then
  # Measured at the bar's device size: identical ascent, identical baseline,
  # identical descender depth, 7% wider. Nothing in the layout has to move.
  good "ChicagoFLF (public domain) -- a metric drop-in for Charcoal"
elif have "Chicago Kare"; then
  # Drawn on a smaller em, so it renders about a fifth small at the same nominal
  # size. The generator compensates with a 1.25x size bump.
  note "Chicago Kare (MIT) -- usable, but drawn small; sizes are scaled 1.25x"
else
  bad "none of Charcoal / ChicagoFLF / Chicago Kare installed"
  # Name the right command for the distro rather than assuming Arch. The theme
  # works without any of these -- it falls back to sans-serif -- so this is
  # advice, not a requirement.
  if command -v yay >/dev/null 2>&1; then
    say "      -> yay -S ttf-chicagoflf          # public domain, closest match"
  elif command -v paru >/dev/null 2>&1; then
    say "      -> paru -S ttf-chicagoflf         # public domain, closest match"
  elif command -v pacman >/dev/null 2>&1; then
    say "      -> the AUR package is ttf-chicagoflf (needs an AUR helper)"
  elif command -v nix-env >/dev/null 2>&1; then
    say "      -> add a ChicagoFLF font derivation to your Nix config"
  elif command -v dnf >/dev/null 2>&1 || command -v apt >/dev/null 2>&1; then
    say "      -> no distro package; drop ChicagoFLF.ttf in ~/.local/share/fonts"
    say "         then run: fc-cache -f"
  else
    say "      -> drop ChicagoFLF.ttf in ~/.local/share/fonts, then fc-cache -f"
  fi
  say "         ChicagoFLF is public domain; Chicago Kare is MIT."
  say "      Charcoal is Apple's and is deliberately not redistributed here."
fi

# ----------------------------------------------------------------- 4. geometry
head_ "Art"
if $CHECK; then
  say "(--check) skipping regeneration"
else
  # mktemp, not /tmp/os99-gen.$$: a predictable name in a world-writable
  # directory can be a symlink somebody else planted, pointing at a file this
  # would then overwrite as you. The private directory goes at the end whether
  # the generator succeeded, failed, or was interrupted.
  GENOUT=$(mktemp -d) || { bad "could not create a temporary directory"; GENOUT=""; }
  if [[ -n $GENOUT ]]; then
    trap 'rm -rf -- "$GENOUT"' EXIT
    log="$GENOUT/generate.log"
    if python3 "$GEN" > "$log" 2>&1; then
      grep -E "^  (scale|font|bar height|ridge|hatch rows|bezel)" "$log" | sed 's/^  /  /'
      if grep -q "MISALIGNED\|<-- " "$log"; then
        note "the generator flagged something above -- read it before shipping"
      else
        good "art regenerated, hatch and buttons aligned"
      fi
    else
      bad "generator failed:"; sed 's/^/      /' "$log"
    fi
    rm -rf -- "$GENOUT"
    trap - EXIT
    GENOUT=""
  fi
fi

# -------------------------------------------------------------------- 5. hooks
head_ "Hooks"
for h in os99-bars-hook.sh os99-gtk.sh; do
  if [[ -f $HOOKS/$h ]]; then good "theme-set.d/$h"
  else bad "theme-set.d/$h missing  ->  omarchy hook install theme-set <path>/$h"; fi
done

# ------------------------------------------------------------ 5b. shell plugins
head_ "Shell plugins"
# One Quickshell bar widget ships with OS 99. It lists windows the title bar's
# collapse box has parked and puts them back, and it sets the menu-bar face.
# (It used to be two widgets, j.os99-font and j.os99-minimized; they were
# merged so the repo could carry a single root manifest, which is what
# `omarchy plugin add` and the plugin marketplace install.)
#
# It needs two separate things: the plugin directory, which the repo carries,
# and an entry in shell.json's bar layout, which it cannot -- shell.json is the
# user's file.

# Drop the merged-away widgets from the bar layout before registering the new
# one, so an upgrade does not leave dead entries the shell warns about.
if [[ -f $SHELLJSON ]] && ! $CHECK; then
  if shelljson has-old 2>/dev/null; then
    backup_shelljson
    if shelljson_write drop-old
    then note "removed old j.os99-* widgets from shell.json (backup written)"
    else bad "could not remove old j.os99-* entries from shell.json"; fi
  fi
fi

register_bar_widget() {
  local id=$1 dir="$HOME/.config/omarchy/plugins/$1"

  if [[ -d $dir ]]; then good "$id: present"; else bad "$id: missing $dir"; return; fi

  if [[ ! -f $SHELLJSON ]]; then
    note "$id: no shell.json, so nothing to register it in"
    return
  fi

  if shelljson has "$id" 2>/dev/null; then
    good "$id: registered in shell.json bar layout"
    return
  fi

  if $CHECK; then
    bad "$id: not registered in shell.json (--check: not modifying)"
    return
  fi

  backup_shelljson
  if shelljson_write add "$id"
  then good "$id: added to shell.json (backup written)"
  else bad "$id: could not edit shell.json -- add {\"id\": \"$id\"} to bar.layout yourself"; fi
}

register_bar_widget "$PLUGIN_ID"

# Registered is not the same as loaded, and only the shell can settle it.
os99_widget_loaded; case $? in
  0) good "$PLUGIN_ID: QML is loaded in the running shell" ;;
  2) note "$PLUGIN_ID: no shell running, so nothing to load into" ;;
  *) bad "$PLUGIN_ID: registered but its QML did not load"
     say "      journalctl --user -e | grep caariiboouu   shows why" ;;
esac

# ------------------------------------------------------------------- 6. plugin
head_ "hyprbars fork"
# This is the piece a theme repo genuinely cannot carry: it is a compiled .so,
# and it must be built against the running Hyprland's headers. hyprpm is the
# supported way -- it clones Hyprland's own sources at your version and builds.
if hyprctl plugin list 2>/dev/null | grep -q hyprbars; then
  good "loaded"
elif $AUTO && [[ -r $HOME/.local/lib/libhyprbars-os99.path || -f /usr/lib/libhyprbars-os99.so ]] \
     && [[ -n $(os99_sibling os99-window-bars) ]] \
     && "$(os99_sibling os99-window-bars)" >/dev/null 2>&1 \
     && hyprctl plugin list 2>/dev/null | grep -q hyprbars; then
  # A build already on disk that simply is not loaded costs a second to try,
  # and compiling Hyprland's headers costs minutes. Try the cheap one first.
  good "loaded the existing build"
elif [[ -r $HOME/.local/lib/libhyprbars-os99.path || -f /usr/lib/libhyprbars-os99.so ]] && ! $AUTO; then
  note "built but not loaded -- run os99-install --auto"
elif $AUTO && command -v hyprpm >/dev/null 2>&1; then
  # Only ever from HERE: nothing is loaded, so there is no live plugin for a
  # reload to pull out from under the compositor. On a machine where the fork
  # IS loaded this branch is unreachable, which is deliberate -- reloading
  # plugins under a running Hyprland is the one operation that can take the
  # session down with it.
  #
  # `hyprpm update` FIRST, and not as a nicety. hyprpm keeps a tree of Hyprland
  # headers built from source, and `hyprpm add` refuses outright -- "Headers
  # outdated, please run hyprpm update" -- when they are missing or stale. On a
  # machine that has never used hyprpm they are always missing, which is to say:
  # on every machine installing this for the first time. Skipping it does not
  # degrade, it fails, and it used to fail with its output thrown away.
  hp_log="$(mktemp)"
  say "building the window-frame plugin against your Hyprland."
  say "The first build on a machine compiles Hyprland itself for headers,"
  say "which is tens of minutes. Later ones are quick."
  if ! hyprpm update >"$hp_log" 2>&1; then
    bad "hyprpm could not build Hyprland's headers:"
    tail -3 "$hp_log" | sed 's/^/      /'
    rm -f "$hp_log"
  else
    hyprpm add "$(repo_url)" >"$hp_log" 2>&1 || true   # already added is fine
    if hyprpm enable hyprbars-os99 >>"$hp_log" 2>&1 && hyprpm reload >>"$hp_log" 2>&1 \
       && hyprctl plugin list 2>/dev/null | grep -q hyprbars; then
      good "built, enabled and loaded"
      rm -f "$hp_log"
    else
      # Say WHY. The version of this that discarded hyprpm's output turned a
      # one-line diagnosis into an afternoon.
      bad "hyprpm could not build the plugin:"
      tail -4 "$hp_log" | sed 's/^/      /'
      say "      hyprpm update && hyprpm add $(repo_url)"
      say "      hyprpm enable hyprbars-os99 && hyprpm reload"
      rm -f "$hp_log"
    fi
  fi
else
  bad "not installed. On another machine this is the step that needs doing:"
  say "      hyprpm update                 # headers; the slow one, once"
  say "      hyprpm add $(repo_url)"
  say "      hyprpm enable hyprbars-os99 && hyprpm reload"
fi

# ---------------------------------------------------------------- 7. looknfeel
head_ "Hyprland look-and-feel"
# Rounded corners and a nine-patch frame are mutually exclusive: rounding CLIPS
# the frame. This used to be the user's problem, because a theme's hyprland.lua
# loads BEFORE looknfeel.lua and so loses to it. The plugin now sets rounding 0
# and no-blur as a per-WINDOW rule on framed windows (frame_force_square and
# frame_force_flat, both on by default), which outranks any global setting --
# so there is nothing here anyone has to edit, and a looknfeel.lua branch left
# over from before is simply redundant.
if [[ -f $LOOKNFEEL ]] && grep -q "os99.marker" "$LOOKNFEEL"; then
  note "looknfeel.lua still branches on os99.marker -- harmless, no longer needed"
else
  good "nothing to edit: the plugin forces square, flat frames per window"
fi

# -------------------------------------------------------------------- 8. theme
head_ "Theme"
THEME_NAME=$(cat "$HOME/.local/state/omarchy/current/theme.name" 2>/dev/null || echo "")
if [[ $THEME_NAME == os-99-* ]]; then
  good "applied ($THEME_NAME)"
elif $CHECK; then
  bad "not applied (--check: not changing it)"
elif $AUTO && command -v omarchy >/dev/null 2>&1; then
  # Noir is the one to land on: light OS 9 chrome around dark content. The
  # frames and the menu bar are the point of this theme, and Noir shows them
  # without also making every editor and terminal white.
  say "applying Os 99 Noir"
  if omarchy theme set "Os 99 Noir" >/dev/null 2>&1; then
    good "applied"
  else
    bad "could not apply -- run: omarchy theme set \"Os 99 Noir\""
  fi
else
  bad "not applied yet -- run: omarchy theme set \"Os 99 Noir\""
fi

head_ "Summary"
printf '  %d ok, %d note, %d missing\n' "$ok" "$warn" "$fail"
if (( fail == 0 )); then
  # Nothing outstanding means nothing was left half-done, whatever mode got
  # us here. --check never writes, so it never clears.
  $CHECK || os99_session_end
  say "Ready."
elif $AUTO; then
  say "Some of it needs you: work through the 'miss' lines above."
else
  say "Work through the 'miss' lines above, or run os99-install --auto to have"
  say "them done for you."
fi
exit 0

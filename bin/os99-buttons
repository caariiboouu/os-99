#!/bin/bash
# Which boxes the title bar shows, and the switch that changes it.
#
#   os99-buttons list            each box: on/off and which side it sits
#   os99-buttons list --json     the same, for the right-click menu
#   os99-buttons toggle <box>    flip one box and re-apply, live
#   os99-buttons apply           re-apply the current config (art + buttons)
#
# The configuration lives in [buttons] left/right of os99-theme.toml --
# corner-first per side, because the plugin fills buttons outward from their
# own edge. This script edits ONLY those two lines and leaves the rest of the
# file exactly as written, comments included.
#
# Applying goes through os99-theme-reload, which redraws the art and re-applies
# the plugin settings through `hyprctl eval` -- no config reload, no plugin
# unload, nothing that can take the compositor down.
set -uo pipefail

die() { echo "os99-buttons: $*" >&2; exit 1; }

# The same chain the generator reads, in the same order, because editing a file
# the generator then ignores would be a very quiet kind of broken.
CFG=""
for c in "${OS99_CONFIG:-}" \
         "$HOME/.config/omarchy/os99-theme.toml" \
         "$HOME/.config/os99/os99-theme.toml" \
         "$HOME/.config/hypr/os99-theme.toml"; do
  [[ -n $c && -f $c ]] && { CFG="$c"; break; }
done
[[ -n $CFG ]] || die "no os99-theme.toml found -- run os99-install first"

command -v python3 >/dev/null 2>&1 || die "python3 not found"

# list | list --json | toggle <box> -- all the toml logic in one place.
buttons_py() {
  python3 - "$CFG" "$@" <<'PY'
import sys, tomllib, json, re, os, stat, tempfile

# Follow a deliberate symlink ONCE and then work on the file it names. Two
# reasons, and they point the same way: people keep this file in a dotfiles
# repository and link it into place, and os.replace() onto a symlink would
# replace the LINK rather than the file, quietly detaching it. Resolving first
# keeps the link, and it also means every later open and rename names a real
# path that no longer has a symlink in its final component to swap out.
def resolved(p):
    return os.path.realpath(p)

def read_text(p):
    fd = os.open(p, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    with os.fdopen(fd, "r", encoding="utf-8") as fh:
        return fh.read()

def publish(p, text):
    """Replace p's contents with text, or leave p exactly as it was.

    A config file is read by a hook, by the generator and by this script, and a
    half-written one is worse than an unchanged one -- so the new text is
    written to a private randomly named file beside it (mkstemp: O_EXCL, mode
    0600, a name nothing can predict and so nothing can pre-plant), forced to
    disk, and moved into place with a rename, which is atomic. A reader either
    sees all of the old file or all of the new one. If anything fails, the
    temporary file goes and p is untouched."""
    d = os.path.dirname(p) or "."
    mode = stat.S_IMODE(os.stat(p).st_mode)
    fd, tmp = tempfile.mkstemp(prefix=".os99-theme.", suffix=".toml.tmp", dir=d)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, p)
        tmp = None
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    # The rename is only durable once the DIRECTORY entry is; without this a
    # crash can leave the old file back.
    dfd = os.open(d, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(dfd)
    finally:
        os.close(dfd)

GLYPHS = ("close", "zoom", "collapse", "shade", "float", "pin", "full", "kill")
LABELS = {"close": "Close", "zoom": "Zoom", "collapse": "Collapse",
          "shade": "Windowshade", "float": "Float", "pin": "Pin",
          "full": "Fullscreen", "kill": "Force Quit"}
# Where a box goes when toggled ON. Close sits on the left, the way OS 9 had
# it, and force quit joins it there: they are the two ways to end the window,
# and the one that ends it RUDELY belongs next to the one that asks nicely
# rather than hiding among the boxes that merely move it about. Everything
# else joins the right side. Order within a side follows GLYPHS, so close
# keeps the corner and kill lands inboard of it.
HOME_SIDE = {g: ("left" if g in ("close", "kill") else "right") for g in GLYPHS}

path, cmd = resolved(sys.argv[1]), sys.argv[2]
cfg = tomllib.loads(read_text(path))
btn = cfg.get("buttons", {})
left  = list(btn.get("left",  ["close"]))
right = list(btn.get("right", ["zoom", "collapse"]))

if cmd == "list":
    rows = [{"id": g, "label": LABELS[g],
             "on": g in left or g in right,
             "side": "left" if g in left else ("right" if g in right else HOME_SIDE[g])}
            for g in GLYPHS]
    if len(sys.argv) > 3 and sys.argv[3] == "--json":
        print(json.dumps({"buttons": rows}))
    else:
        for r in rows:
            print(f"{'on ' if r['on'] else 'off'}  {r['id']:<9} {r['side']:<6} {r['label']}")
    raise SystemExit(0)

if cmd != "toggle":
    raise SystemExit(f"unknown command {cmd!r}")
g = sys.argv[3]
if g not in GLYPHS:
    raise SystemExit(f"no such box {g!r} -- one of: {', '.join(GLYPHS)}")

if g in left or g in right:
    left  = [x for x in left  if x != g]
    right = [x for x in right if x != g]
    state = "off"
else:
    # Insert in canonical order so the corners stay predictable: zoom keeps
    # the top-right corner whenever it is on at all.
    lst = left if HOME_SIDE[g] == "left" else right
    order = [x for x in GLYPHS if HOME_SIDE[x] == HOME_SIDE[g]]
    lst.append(g)
    lst.sort(key=order.index)
    state = "on"

def fmt(lst):
    return "[" + ", ".join(f'"{x}"' for x in lst) + "]"

# Surgical edit: rewrite (or insert) just the left/right lines inside
# [buttons]. tomllib has no writer, and round-tripping the whole file would
# lose every comment in it.
lines = read_text(path).splitlines(keepends=True)
out, in_btn, done = [], False, {"left": False, "right": False}
for ln in lines:
    stripped = ln.strip()
    if stripped.startswith("["):
        if in_btn:  # leaving [buttons]: insert anything not yet written
            for key in ("left", "right"):
                if not done[key]:
                    out.append(f"{key:<9} = {fmt(left if key == 'left' else right)}\n")
        in_btn = stripped == "[buttons]"
    if in_btn:
        m = re.match(r"(\s*)(left|right)\s*=", ln)
        if m:
            key = m.group(2)
            out.append(f"{m.group(1)}{key:<9} = {fmt(left if key == 'left' else right)}\n")
            done[key] = True
            continue
    out.append(ln)
if in_btn:
    for key in ("left", "right"):
        if not done[key]:
            out.append(f"{key:<9} = {fmt(left if key == 'left' else right)}\n")
if not any(l.strip() == "[buttons]" for l in lines):
    out.append("\n[buttons]\n")
    out.append(f"left      = {fmt(left)}\n")
    out.append(f"right     = {fmt(right)}\n")
publish(path, "".join(out))
print(f"{g} {state}")
PY
}

# os99-theme-reload is what turns an edited config into a redrawn bar. Look for
# it BESIDE this script first: the right-click menu runs this copy out of the
# installed plugin directory, and the shell process's PATH is not a login
# shell's -- it does not necessarily carry ~/.local/bin, and relying on it would
# mean the menu edited the config and then quietly failed to apply it. Sibling,
# then the usual install location, then PATH.
find_reload() {
  local here candidate
  here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P) || here=""
  for candidate in "$here/os99-theme-reload" "$HOME/.local/bin/os99-theme-reload"; do
    [[ -n $candidate && -x $candidate ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  command -v os99-theme-reload 2>/dev/null
}

apply_live() {
  local reload
  reload=$(find_reload)
  [[ -n $reload ]] || {
    echo "os99-buttons: changed $CFG; os99-theme-reload not found, apply skipped" >&2
    return 0
  }
  "$reload" >/dev/null 2>&1 || echo "os99-buttons: os99-theme-reload failed" >&2
}

case "${1:-list}" in
  list)    buttons_py list "${2:-}" ;;
  toggle)
    [[ -n ${2:-} ]] || die "usage: os99-buttons toggle <box>"
    buttons_py toggle "$2" || exit 1
    apply_live
    ;;
  apply)   apply_live ;;
  -h|--help|help)
    sed -n '2,16p' "$0" | sed 's/^# \?//'
    ;;
  *) die "unknown command '$1' (list | toggle <box> | apply)" ;;
esac

#!/bin/bash
# Open the title bar's right-click menu at the cursor.
#
#   os99-bar-menu [0xADDRESS]
#
# The hyprbars fork spawns this on a right-click that lands on bar face rather
# than on a box, passing the clicked window's address. The menu itself lives in
# the Omarchy shell (shell-plugin/os99/Menu.qml) and is reached over shell IPC,
# so without Omarchy this exits quietly and the CLI (`os99-buttons`) remains
# the way to configure the boxes.
set -uo pipefail

command -v hyprctl >/dev/null 2>&1 || exit 0
command -v omarchy-shell >/dev/null 2>&1 || exit 0

ADDR="${1:-}"
# The address travels into a JSON string; it came from the compositor, but this
# script is callable by hand, so hold it to the shape an address has.
[[ $ADDR =~ ^(0x[0-9a-fA-F]+)?$ ]] || ADDR=""

# "1234, 567" -> logical global coordinates, the same space the shell's
# screens are laid out in.
POS=$(hyprctl cursorpos 2>/dev/null) || POS=""
X="${POS%%,*}"
Y="${POS##*, }"
[[ $X =~ ^-?[0-9]+$ && $Y =~ ^-?[0-9]+$ ]] || { X=0; Y=0; }

exec omarchy-shell -q os99 menu "{\"x\":$X,\"y\":$Y,\"window\":\"$ADDR\"}"

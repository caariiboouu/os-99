# Generated by generate-art.py from ~/.config/omarchy/os99-theme.toml
# Do not edit -- edit the toml and run os9-theme-reload.
# The hook compares this against the live display and redraws on a mismatch.
# Without it, art baked on the author's machine silently renders at the wrong
# SIZE on anyone else's, because it is blitted 1:1.
OS99_ART_SCALE=1.0
OS99_ART_PALETTE=light
OS99_BAR_HEIGHT=28
OS99_BEZEL=6
OS99_SHADOW_RANGE=0
OS99_SHADOW_OFFSET_X=2
OS99_SHADOW_OFFSET_Y=3
OS99_SHADOW_COLOR="rgba(00000099)"
OS99_SHADOW_COLOR_INACTIVE="rgba(00000038)"
OS99_FRAME_UNSCALED=false
OS99_FRAME_OVER=true
OS99_BOX_SIZE=12
OS99_BTN_EDGE_PAD=1
OS99_BTN_GAP=4
OS99_BTN_CLEAR_PAD=7
OS99_TEXT_SIZE=12
OS99_TEXT_FONT="Charcoal"
OS99_UI_FONT="Charcoal 11"
OS99_TEXT_CLEAR_PAD=8
OS99_CLEAR_INSET_TOP=2
OS99_CLEAR_INSET_BOTTOM=1
OS99_FACE="rgb(D5D6D5)"
OS99_CLEAR_COLOR="rgb(D5D6D5)"
OS99_TEXT_COLOR="rgb(000000)"
OS99_FRAME_BORDER="28 6 6 6"
OS99_FRAME_INSET="28 6 6 6"
